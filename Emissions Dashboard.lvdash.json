{
  "datasets": [
    {
      "name": "ff976ddc",
      "displayName": "Loc Data",
      "queryLines": [
        "SELECT \r\n",
        "   latitude,\r\n",
        "  longitude,\r\n",
        "  `GHG emissions mtons CO2e` as Emissions\r\n",
        "FROM emissions.default.emissions_data"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "5f459b25",
      "displayName": "Emission/Person",
      "queryLines": [
        "SELECT county_state_name, population, \r\n",
        "  CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / CAST(population AS DOUBLE) AS emissions_per_population\r\n",
        "FROM emissions.default.emissions_data"
      ]
    },
    {
      "name": "68056bde",
      "displayName": "Emession per State",
      "queryLines": [
        "SELECT state_abbr,\r\n",
        "  SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) as Total_Emission\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY Total_Emission DESC"
      ]
    },
    {
      "name": "5e8bdcb2",
      "displayName": "Emession per State Limit top 10",
      "queryLines": [
        "SELECT state_abbr,\r\n",
        "  SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) as Total_Emission\r\n",
        "FROM emissions.default.emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY Total_Emission DESC\r\n",
        "LIMIT 10"
      ]
    }
  ],
